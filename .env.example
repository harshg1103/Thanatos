# THANATOS Configuration Environment Variables

# LLM Providers
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Probing & Sandbox Settings
MOCK_LLM_MODE=true  # Set to false to use real LLM APIs
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
WEBSOCKET_PORT=8001

# Databases & Vector Stores
LANCE_DB_PATH=./data/lancedb
QDRANT_HOST=localhost
QDRANT_PORT=6333
POSTGRES_URI=postgresql://thanatos:thanatos_secret@localhost:5432/thanatos_db

# Observability
WANDB_PROJECT=thanatos-neurosymbolic
WANDB_API_KEY=your_wandb_api_key_here
